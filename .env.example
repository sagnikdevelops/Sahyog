# Sahyog Environment Configuration Template
# Application: Sahyog - Connecting Cooperative Skills with Everyday Needs

# Supabase (PostgreSQL & PostGIS Database + Auth + Storage + Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-placeholder

# Mock / Sandbox Payment Provider (Razorpay / Cashfree test mode or built-in mock engine)
PAYMENT_PROVIDER_KEY=test_key_sahyog_demo
PAYMENT_PROVIDER_SECRET=test_secret_sahyog_demo

# Map & Geolocation Configuration (OpenStreetMap / Leaflet)
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# FCM / Notification Keys (Optional for MVP)
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=